			<ExtendedData>
				<SchemaData schemaUrl="#S_Atributlar_21_10_2023_ISSSSSISSSSSSSSSSSSS">
					<SimpleData name="Milliy_ro_yxatdagi_raqam__agar_bo_lsa_">3</SimpleData>
					<SimpleData name="Yodgorlik_nomi">Qo’rg’ontepa</SimpleData>
					<SimpleData name="Ikkinchi_nomi__agar_bo_lsa_">0</SimpleData>
					<SimpleData name="Manzili">Sirdaryo viloyati Sirdaryo</SimpleData>
					<SimpleData name="Koordinata_X">40°49&apos;30.77</SimpleData>
					<SimpleData name="Koordinata_Y">68°40&apos;57.86</SimpleData>
					<SimpleData name="Balandligi">3</SimpleData>
					<SimpleData name="Dengiz_sathidan_balandligi_">267 м</SimpleData>
					<SimpleData name="Maydoni__ga_hisobiga_">0,70 ga</SimpleData>
					<SimpleData name="Saqlanish_holati___0__Buzilgan_">75-100 foiz saqlangan</SimpleData>
					<SimpleData name="Hozirgi_holati_va_faoliyati">Faoliyatdagi qabriston</SimpleData>
					<SimpleData name="Yodgorlik_tavsifi">Qo’rg’ontepa. Sirdaryo shaxrining chegarasida J.Mamanov SFU xududida joylashgan. To’g’ri to’rtburchak shaklidagi formaga ega. O’lchamlari 97x74 m, balandligi 3 m. shimoliy-sharqiy qismida arki joylashgan. Arkining o’lchamlari 45X40 m, balandligi 10 m. qabriston bilan band qilingan. Yuqori qismida sirlanmagan sopol idishlar ilk o’rta asrlarga oid bo’lgan materiallar uchraydi. O’rganilish tarixi: O’zR Fanlar Akademiyasi Arxeologiya institutining 1984-85 yidlardagi Sirdaryo arxeologiya guruhi tadqiqotlari.</SimpleData>
					<SimpleData name="Turi_">Shahar va Qishloq makoni</SimpleData>
					<SimpleData name="Davrlari">Rivojlangan o&apos;rta asrlar, Mug&apos;ullar davri, Temuriylar davri</SimpleData>
					<SimpleData name="Asri">mil. V-IX asrlar</SimpleData>
					<SimpleData name="Ko_rinishi">0</SimpleData>
					<SimpleData name="Birlamchi_tadqiqot_o_tkazilgan__razvedka_">Birlamchi tadqiqot o’tkazilgan (razvedka)</SimpleData>
					<SimpleData name="Manba__adabiyotlar">Археологические памятники Сырдарьинской области. Ташкент: Фан, 1992. 69 с.</SimpleData>
					<SimpleData name="Hududiy_tavsifi">Kadastr xujjatlari bor, Atrofi o’ralgan, Ma’lumot taxtasi mavjud</SimpleData>
					<SimpleData name="Ma_lumotni_kiritgan_shaxs">О.У. Мамиров</SimpleData>
				</SchemaData>
			</ExtendedData>
