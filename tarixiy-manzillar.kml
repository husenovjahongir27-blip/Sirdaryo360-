					<SimpleData name="Manba__adabiyotlar">0</SimpleData>
					<SimpleData name="Hududiy_tavsifi">Kadastr xujjatlari bor</SimpleData>
					<SimpleData name="Ma_lumotni_kiritgan_shaxs">О.У. Мамиров</SimpleData>
