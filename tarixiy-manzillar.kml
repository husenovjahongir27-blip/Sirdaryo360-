	<Folder id="layer 0">
		<name>Atributlar_21_10_2023</name>
		<open>1</open>
		<Placemark>
			<name>Katta qiztepa</name>
			<styleUrl>#pointStyleMap</styleUrl>
			<Style id="inline">
				<IconStyle>
					<color>ffe7ebef</color>
					<colorMode>normal</colorMode>
				</IconStyle>
				<LineStyle>
					<color>ffe7ebef</color>
