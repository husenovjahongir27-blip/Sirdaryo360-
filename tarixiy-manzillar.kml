			<ExtendedData>
				<SchemaData schemaUrl="#S_Atributlar_21_10_2023_ISSSSSISSSSSSSSSSSSS">
					<SimpleData name="Milliy_ro_yxatdagi_raqam__agar_bo_lsa_">29</SimpleData>
					<SimpleData name="Yodgorlik_nomi">Eski Xovos shaharchasi</SimpleData>
					<SimpleData name="Ikkinchi_nomi__agar_bo_lsa_">0</SimpleData>
					<SimpleData name="Manzili">Sirdaryo viloyati Xovos</SimpleData>
					<SimpleData name="Koordinata_X">40°11&apos;59.39</SimpleData>
					<SimpleData name="Koordinata_Y">68°48&apos;39.82</SimpleData>
					<SimpleData name="Balandligi">19</SimpleData>
					<SimpleData name="Dengiz_sathidan_balandligi_">379 м</SimpleData>
					<SimpleData name="Maydoni__ga_hisobiga_">12 ga</SimpleData>
					<SimpleData name="Saqlanish_holati___0__Buzilgan_">75-100 foiz saqlangan</SimpleData>
					<SimpleData name="Hozirgi_holati_va_faoliyati">Qabristonga aylantirilgan</SimpleData>
					<SimpleData name="Yodgorlik_tavsifi">Eski Xovos. Shu nomli temir yo’l bekati yaqinida, soyning o’ng qirg’og’ida joylashgan. M.E. Masson tomonidan yodga olinadi (Masson, 1934, 16-b.). 1984 va 1988 yillarda uni Sirdaryo arxeologik otryadi tadqiq etgan, 1988-1989, 2003-2004 yillarda u erda qazishmalar o’tkazilgan (Gritsina, 1990, 12-13, 15-16-bb.; Gritsina, Ivanitskiy, Rahimov, 2004, 61-64-bb.). Xarobalar hududi o’ta buzilgan. Yodgorlik ustidan ko’plab X-XX asrlarga oid sopol va tangalar topilgan. Arki a’lo yodgorlikning shimoli-g’arbiy qismida joylashgan. Unga bir-biridan chim devor bilan ajratilgan ikki hudud (shahriston) tutashadi. Xarobalarning umumiy maydoni 10-12 ga, undan 2 ga yaqin xududda arki a’lo joylashgan. Yodgorlikdan olingan materiallar asosida unda milodgacha I asrlardan milodiy XX asrlargacha uzluksiz hayot bo’lgan.</SimpleData>
					<SimpleData name="Turi_">Shahar va Shaharcha</SimpleData>
					<SimpleData name="Davrlari">Antik, Ilk o&apos;rta asr, Rivojlangan o&apos;rta asrlar, Mug&apos;ullar davri, Temuriylar davri, So&apos;nggi o&apos;rta asrlar</SimpleData>
					<SimpleData name="Asri">mil.avv. IV-mil. XX asrlar</SimpleData>
					<SimpleData name="Ko_rinishi">Planigrafik qazishma ko’rinishida, Shurf ko’rinishida</SimpleData>
					<SimpleData name="Birlamchi_tadqiqot_o_tkazilgan__razvedka_">Birlamchi tadqiqot o’tkazilgan (razvedka)</SimpleData>
					<SimpleData name="Manba__adabiyotlar">Археологические памятники Сырдарьинской области. Ташкент: Фан, 1992. 69 с.</SimpleData>
					<SimpleData name="Hududiy_tavsifi">Kadastr xujjatlari bor, Ma’lumot taxtasi mavjud</SimpleData>
					<SimpleData name="Ma_lumotni_kiritgan_shaxs">О.У. Мамиров</SimpleData>
				</SchemaData>
			</ExtendedData>
