				</PolyStyle>
			</Style>
			<ExtendedData>
				<SchemaData schemaUrl="#S_Atributlar_21_10_2023_ISSSSSISSSSSSSSSSSSS">
					<SimpleData name="Milliy_ro_yxatdagi_raqam__agar_bo_lsa_">1</SimpleData>
					<SimpleData name="Yodgorlik_nomi">Katta qiztepa</SimpleData>
					<SimpleData name="Ikkinchi_nomi__agar_bo_lsa_">Quttiqiztepa</SimpleData>
					<SimpleData name="Manzili">Sirdaryo viloyati Sirdaryo</SimpleData>
					<SimpleData name="Koordinata_X">40°53&apos;50.99</SimpleData>
					<SimpleData name="Koordinata_Y">68°6&apos;37.36</SimpleData>
					<SimpleData name="Balandligi">5</SimpleData>
					<SimpleData name="Dengiz_sathidan_balandligi_">259 м</SimpleData>
					<SimpleData name="Maydoni__ga_hisobiga_">11,7 ga</SimpleData>
					<SimpleData name="Saqlanish_holati___0__Buzilgan_">75 fozigacha saqlangan</SimpleData>
					<SimpleData name="Hozirgi_holati_va_faoliyati">Eski qabriston, Faoliyatdagi qabriston</SimpleData>
					<SimpleData name="Yodgorlik_tavsifi">Quttiqiztepa. Sirdaryo viloyati Sirdaryo tumani, Furqat MFY, Bog’ora maxallasi hududida joylashgan. Yodgorlik umumiy maydoni 17-18 ga bo’lib u an’anaviy formaga ega. Uning rel’efiga ko’ra ark, shaxriston va rabodlarga ega bo’lgan shaxar ekanligini taxmin qilish mumkin. Mustaxkamlangan ark qismiga ega, tsitadel o’lchami 60x48 m, balandligi 5 m bo’lib, janub va sharq tomonlardan aniq bo’lmagan o’lchamli hudud bilan tutashib ketgan. Er ustki ko’tarma materiallari asosan o’rta asrlarga qisman antik davrga oid.O’zR Fanlar Akademiyasi Arxeologiya institutining 1984-85 yidlardagi Sirdaryo arxeologiya guruhi tadqiqotlari.</SimpleData>
					<SimpleData name="Turi_">Shaharcha</SimpleData>
					<SimpleData name="Davrlari">Antik, Ilk o&apos;rta asr, Rivojlangan o&apos;rta asrlar</SimpleData>
					<SimpleData name="Asri">mil.avv. I-mil. XII asrlar</SimpleData>
					<SimpleData name="Ko_rinishi">Shurf ko’rinishida</SimpleData>
					<SimpleData name="Birlamchi_tadqiqot_o_tkazilgan__razvedka_">Birlamchi tadqiqot o’tkazilgan (razvedka)</SimpleData>
					<SimpleData name="Manba__adabiyotlar">Археологические памятники Сырдарьинской области. Ташкент: Фан, 1992. 69 с.</SimpleData>
					<SimpleData name="Hududiy_tavsifi">Kadastr xujjatlari bor, Ma’lumot taxtasi mavjud</SimpleData>
					<SimpleData name="Ma_lumotni_kiritgan_shaxs">О.У. Мамиров</SimpleData>
				</SchemaData>
			</ExtendedData>
			<Point>
				<coordinates>68.11037777777779,40.89749722222221,0</coordinates>
			</Point>
		</Placemark>
		<Placemark>
			<name>Puchuktepa</name>
			<styleUrl>#pointStyleMap</styleUrl>
			<Style id="inline">
				<IconStyle>
					<color>ffe7ebef</color>
					<colorMode>normal</colorMode>
				</IconStyle>
				<LineStyle>
					<color>ffe7ebef</color>
